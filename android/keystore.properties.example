# Copy to android/keystore.properties (gitignored) for release AAB builds.
# Never commit this file or the keystore itself.
#
# Generate a release keystore (one-time, store securely):
#   keytool -genkey -v -keystore release.keystore -alias booray -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile path is relative to android/ (project root for Gradle), e.g. ../release.keystore
storeFile=../release.keystore
storePassword=REPLACE_WITH_KEYSTORE_PASSWORD
keyAlias=booray
keyPassword=REPLACE_WITH_KEY_PASSWORD
