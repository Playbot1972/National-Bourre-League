# Copy to .env.firebase (gitignored) before production deploy or native release builds.
# Values: Firebase Console → Project settings → Your apps → Web app → SDK setup
#
# Then run:
#   node scripts/ensure-firebase-config.js
# Required for: npm run deploy, npm run build:cap:android:release

FIREBASE_API_KEY=AIza...
FIREBASE_PROJECT_ID=national-bourre-league
FIREBASE_APP_ID=1:123456789:web:abcdef
FIREBASE_AUTH_DOMAIN=booray.win
